# Environment Variables for Polaris Microservices
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=super-secret-polaris-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# External APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Service URLs for internal sync REST calls
AUTH_SERVICE_URL=http://auth-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
EQUIPMENT_SERVICE_URL=http://equipment-service:8003
OBSERVATION_SERVICE_URL=http://observation-service:8004
QUEST_SERVICE_URL=http://quest-service:8005
VERIFICATION_SERVICE_URL=http://verification-service:8006
WEATHER_SERVICE_URL=http://weather-service:8007
